datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  fullName     String
  phone        String?
  resetToken   String?
  verifyToken  String?
  verified     Boolean   @default(false)
  orders       Order[]
}

model Order {
  id              String  @id @default(uuid())
  userId          String
  total           Decimal
  shippingAddress String
  user            User    @relation(fields: [userId], references: [id])
}
